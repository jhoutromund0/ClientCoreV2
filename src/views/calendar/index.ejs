<main id="main-content" class="shell inner-page">
  <div class="page-title-row">
    <div>
      <h1>Calendário de visitas</h1>
      <p class="muted">Acompanhe os atendimentos e selecione um dia para agendar.</p>
    </div>
    <div class="action-group">
      <a class="button button-ghost" href="<%= todayUrl %>">Ir para hoje</a>
      <a class="button" href="/calendario/nova">Nova visita</a>
    </div>
  </div>

  <div class="split-layout">
    <aside class="stack">
      <% if (!undated) { %>
      <div class="stat-card"><span>Visitas no mês exibido</span><strong><%= total %></strong></div>
      <% } %>
      <form class="panel filter-panel stack" action="/calendario" method="get">
        <input type="hidden" name="mes" value="<%= month %>">
        <h2>Filtrar por cliente</h2>
        <label>Nome do cliente
          <input name="cliente" type="search" placeholder="Digite o nome do cliente" value="<%= search %>" maxlength="160">
        </label>
        <div class="action-group">
          <button class="button button-ghost" type="submit">Filtrar</button>
          <% if (search) { %><a class="text-button" href="/calendario?mes=<%= month %>">Limpar filtro</a><% } %>
        </div>
      </form>
      <% if (hasUndated && !undated) { %><a class="text-button" href="/calendario?mes=sem-data">Visitas com data a corrigir</a><% } %>
    </aside>

    <% if (!undated) { %>
    <section class="panel calendar-month">
      <div class="panel-head">
        <h2>Agenda mensal</h2>
        <nav class="month-nav" aria-label="Navegar pelos meses">
          <% if (previousUrl) { %><a class="month-step" href="<%= previousUrl %>" aria-label="Mês anterior">‹</a><% } %>
          <p><%= monthLabel %></p>
          <% if (nextUrl) { %><a class="month-step" href="<%= nextUrl %>" aria-label="Próximo mês">›</a><% } %>
        </nav>
      </div>
      <div class="weekday-row" aria-hidden="true"><span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span></div>
      <div class="calendar-grid">
        <% for (const day of days) { %>
          <% if (!day) { %>
          <div class="day-cell blank" aria-hidden="true"></div>
          <% } else { %>
          <div class="day-cell <%= day.isToday ? 'today' : '' %>">
            <div class="day-top">
              <time datetime="<%= day.date %>"><%= day.day %></time>
              <a class="agendar-dia" href="/calendario/nova?data=<%= day.date %>" aria-label="Agendar visita no dia <%= day.day %>">+</a>
            </div>
            <% if (day.count) { %>
            <details class="day-visits">
              <summary class="visit-count" aria-label="<%= day.count %> <%= day.count === 1 ? 'visita' : 'visitas' %> no dia <%= day.day %>">
                <%= day.count %><span class="visit-count-label"> <%= day.count === 1 ? 'visita' : 'visitas' %></span>
              </summary>
              <ul class="day-visit-preview" aria-label="Visitas do dia <%= day.day %>">
                <% for (const visit of day.preview) { %>
                <li>
                  <span title="<%= visit.clientName %>"><%= visit.clientName %></span>
                  <% if (visit.time) { %><time datetime="<%= visit.time %>"><%= visit.time %></time><% } else { %><span aria-label="Sem horário">—</span><% } %>
                </li>
                <% } %>
              </ul>
            </details>
            <% } %>
          </div>
          <% } %>
        <% } %>
      </div>
    </section>
    <% } %>
  </div>

  <section class="panel visits-panel">
    <div class="panel-head">
      <h2><%= undated ? 'Visitas com data a corrigir' : 'Visitas do mês' %></h2>
      <a class="text-button" href="/visitas">Consultar todas as visitas</a>
    </div>
    <% if (visits.length) { %>
    <div class="visit-grid">
      <% visits.forEach(visit => { %><%- include('../visits/card', { visit, operational: false }) %><% }) %>
    </div>
    <% } else { %>
    <div class="empty-state compact"><p>Nenhuma visita encontrada para este filtro.</p></div>
    <% } %>
    <%- include('../partials/pagination', { page, path: '/calendario', params: search ? { mes: month, cliente: search } : { mes: month } }) %>
  </section>
</main>
<script src="/js/calendar.js" defer></script>
