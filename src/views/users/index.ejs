<main id="main-content" class="shell inner-page">
  <div class="page-title-row">
    <div>
      <h1>Usuários do sistema</h1>
      <p class="muted">Somente administradores podem gerenciar acessos.</p>
    </div>
  </div>
  <%- include('../settings/nav', { section: 'users' }) %>

  <% if (error) { %>
  <p class="validation-errors" role="alert"><%= error %></p>
  <% } %>
  <% if (link) { %>
  <section class="panel-form" aria-labelledby="password-link-heading">
    <h2 id="password-link-heading">Link para definir a senha</h2>
    <p class="muted">Envie o link em particular para <%= link.email %>. Ele é válido por uma hora e pode ser usado uma vez.</p>
    <label>Link de acesso
      <input readonly type="text" value="<%= link.url %>">
    </label>
  </section>
  <% } %>

  <div class="split-layout">
    <form class="panel-form" method="post" action="/configuracoes/usuarios" aria-labelledby="new-user-heading">
      <%- include('../partials/csrf-field') %>
      <h2 id="new-user-heading">Convidar usuário</h2>
      <div class="form-grid one-col">
        <label>Nome
          <input name="name" minlength="2" maxlength="120" required>
        </label>
        <label>E-mail
          <input name="email" type="email" maxlength="254" required>
        </label>
        <label>Perfil
          <select name="role">
            <option value="analista">Analista</option>
            <option value="admin">Administrador</option>
          </select>
        </label>
        <label>Tarifa de reembolso (R$/km)
          <input name="mileageRate" inputmode="decimal" maxlength="9" placeholder="Tarifa da empresa">
        </label>
        <label>Sua senha atual
          <input name="currentPassword" type="password" autocomplete="current-password" maxlength="200" required>
        </label>
      </div>
      <div class="form-actions">
        <button class="button" type="submit">Gerar convite</button>
      </div>
    </form>

    <section class="panel" aria-labelledby="registered-users-heading">
      <div class="panel-head">
        <h2 id="registered-users-heading">Contas cadastradas</h2>
      </div>
      <% if (users.length) { %>
      <div class="stack">
        <% users.forEach((account) => { %>
        <% const isOwnAccount = typeof user !== 'undefined' && user?.id === account.id; %>
        <details class="user-account">
          <summary>
            <span class="user-identity">
              <strong><%= account.name %></strong>
              <span class="muted"><%= account.email %></span>
            </span>
            <span class="user-account-status">
              <span><%= account.role === 'admin' ? 'Administrador' : 'Analista' %></span>
              <span class="user-status<%= account.active && !account.pending ? ' user-status-active' : '' %>"><%= !account.active ? 'Inativa' : account.pending ? 'Convite pendente' : 'Ativa' %></span>
            </span>
          </summary>
          <div class="user-account-body">
            <form class="panel-form plain" method="post" action="/configuracoes/usuarios/<%= account.id %>">
              <%- include('../partials/csrf-field') %>
              <div class="form-grid">
                <label>Nome
                  <input name="name" value="<%= account.name %>" minlength="2" maxlength="120" required>
                </label>
                <label>E-mail
                  <input name="email" type="email" value="<%= account.email %>" maxlength="254" required>
                </label>
                <label>Perfil
                  <select name="role">
                    <option value="analista"<%= account.role === 'analista' ? ' selected' : '' %>>Analista</option>
                    <option value="admin"<%= account.role === 'admin' ? ' selected' : '' %>>Administrador</option>
                  </select>
                </label>
                <label>Tarifa de reembolso (R$/km)
                  <input name="mileageRate" inputmode="decimal" maxlength="9" placeholder="Tarifa da empresa"
                         value="<%= account.mileage_rate_cents_per_km == null ? '' : (account.mileage_rate_cents_per_km / 100).toFixed(2).replace('.', ',') %>">
                </label>
                <label>Sua senha atual
                  <input name="currentPassword" type="password" autocomplete="current-password" maxlength="200" required>
                </label>
                <label class="user-active">
                  <input name="active" type="checkbox" value="on"<%= account.active ? ' checked' : '' %>>
                  Conta ativa
                </label>
              </div>
              <div class="form-actions">
                <button class="button" type="submit">Salvar alterações</button>
              </div>
            </form>
              <% if (!isOwnAccount) { %>
            <% if (account.active) { %>
            <form class="panel-form plain" method="post" action="/configuracoes/usuarios/<%= account.id %>/recuperar">
              <%- include('../partials/csrf-field') %>
              <label>Sua senha atual
                <input name="currentPassword" type="password" autocomplete="current-password" maxlength="200" required>
              </label>
              <div class="form-actions">
                <button class="button button-ghost" type="submit">Gerar novo link de acesso</button>
              </div>
            </form>
            <% } %>
            <form class="panel-form plain" method="post" action="/configuracoes/usuarios/<%= account.id %>/excluir" data-confirm="Excluir esta conta?">
              <%- include('../partials/csrf-field') %>
              <label>Sua senha atual
                <input name="currentPassword" type="password" autocomplete="current-password" maxlength="200" required>
              </label>
              <div class="form-actions">
                <button class="button button-ghost danger" type="submit">Excluir usuário</button>
              </div>
            </form>
            <% } %>
          </div>
        </details>
        <% }) %>
      </div>
      <% } else { %>
      <p class="muted">Nenhuma conta cadastrada.</p>
      <% } %>
      <%- include('../partials/pagination', { page, path: '/configuracoes/usuarios' }) %>
    </section>
  </div>
</main>
