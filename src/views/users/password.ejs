<main id="main-content" class="auth-wrap">
  <section class="auth-card">
    <h1><%= firstLogin ? 'Troque sua senha temporária' : 'Defina sua senha' %></h1>
    <% if (error) { %>
    <p class="flash error" role="alert"><%= error %></p>
    <% } %>
    <% if (firstLogin || token) { %>
    <form class="form-stack" method="post" action="<%= firstLogin ? '/acesso/primeiro-acesso' : '/acesso/definir-senha' %>">
      <%- include('../partials/csrf-field') %>
      <% if (firstLogin && next) { %>
      <input type="hidden" name="next" value="<%= next %>">
      <% } %>
      <% if (token) { %>
      <input type="hidden" name="token" value="<%= token %>">
      <% } %>
      <%- include('new-password-fields') %>
      <button class="button full" type="submit">Salvar senha</button>
    </form>
    <% } %>
  </section>
</main>
