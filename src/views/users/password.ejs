<main id="main-content" class="auth-wrap">
  <section class="auth-card">
    <h1>Defina sua senha</h1>
    <% if (error) { %>
    <p class="flash error" role="alert"><%= error %></p>
    <% } %>
    <% if (token) { %>
    <form class="form-stack" method="post" action="/acesso/definir-senha">
      <%- include('../partials/csrf-field') %>
      <input type="hidden" name="token" value="<%= token %>">
      <%- include('new-password-fields') %>
      <button class="button full" type="submit">Salvar senha</button>
    </form>
    <% } %>
  </section>
</main>
