<main id="main-content" class="shell inner-page form-page">
  <h1>Configurações</h1>
  <%- include('nav', { section: 'travel' }) %>
  <p class="muted">O valor do deslocamento considera a distância de ida e volta. Quando o responsável tem uma tarifa individual, ela é usada na visita.</p>

  <% if (routeErrors.length) { %>
  <div class="validation-errors" role="status">
    <strong>Configuração do cálculo automático</strong>
    <ul><% routeErrors.forEach(error => { %><li><%= error %></li><% }) %></ul>
    <p>A quilometragem pode ser informada manualmente na visita.</p>
  </div>
  <% } %>

  <% if (errors.length) { %>
  <div class="validation-errors" role="alert">
    <ul>
      <% errors.forEach((error) => { %>
      <li><%= error %></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <form class="settings-form" action="/configuracoes" method="post">
    <%- include('../partials/csrf-field') %>
    <div class="form-grid">
      <label class="settings-address-field">
        Endereço da empresa
        <input name="originAddress" value="<%= settings.originAddress %>" maxlength="300" required placeholder="Rua, número, bairro, cidade, UF e CEP">
      </label>
      <label>
        Tarifa padrão de deslocamento (R$/km)
        <input name="rate" value="<%= settings.rate %>" inputmode="decimal" maxlength="9" required placeholder="10,00">
      </label>
    </div>
    <div class="form-actions">
      <button class="button" type="submit">Salvar configurações</button>
    </div>
  </form>
</main>
