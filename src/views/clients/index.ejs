<main id="main-content" class="shell inner-page">
  <div class="page-title-row">
    <div>
      <span class="eyebrow">
        GESTÃO
      </span>
      <h1>
        Clientes
      </h1>
      <p class="muted">
        Cadastre e organize os dados das empresas atendidas.
      </p>
    </div>
    <a class="button" href="/clientes/novo">
      + Novo cliente
    </a>
  </div>
  <% if (clients.length) { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>
            Nome
          </th>
          <th>
            Empresa
          </th>
          <th>
            CNPJ
          </th>
          <th>
            E-mail
          </th>
          <th>
            Telefone
          </th>
          <th>
            Endereço
          </th>
          <th>
            Tipo de estabelecimento
          </th>
          <th>
            Deslocamento
          </th>
          <th>
            Ações
          </th>
        </tr>
      </thead>
      <tbody>
        <% clients.forEach(client => { %>
        <tr>
          <td>
            <strong>
              <%= client.name %>
            </strong>
          </td>
          <td>
            <%= client.company || '—' %>
          </td>
          <td>
            <%= client.cnpj || '—' %>
          </td>
          <td>
            <%= client.email || '—' %>
          </td>
          <td>
            <%= client.phone || '—' %>
          </td>
          <td class="client-address">
            <%= client.address || '—' %>
          </td>
          <td>
            <%= client.establishmentType === 'matriz' ? 'Matriz' : client.establishmentType === 'filial' ? 'Filial' : '—' %>
          </td>
          <td>
            <% if (client.tripDisplay) { %>
            <%- include('travel', { trip: client.tripDisplay }) %>
            <% } else { %>
            —
            <% } %>
          </td>
          <td class="actions">
            <a href="/clientes/<%= client.id %>/editar">Editar
            </a>
            <form action="/clientes/<%= client.id %>/excluir" method="post" data-confirm="Excluir este cliente?">
              <%- include('../partials/csrf-field') %>
              <button class="text-button danger" type="submit">
                Excluir
              </button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } else { %>
  <section class="empty-state">
    <span class="empty-icon">
      ◎
    </span>
    <h2>
      Nenhum cliente cadastrado
    </h2>
    <p>
      Comece adicionando a primeira empresa.
    </p>
    <a class="button" href="/clientes/novo">
      Cadastrar primeiro cliente →
    </a>
  </section>
  <% } %>
  <%- include('../partials/pagination', { page, path: '/clientes' }) %>
  <p class="storage-note">
    ⓘ Dados armazenados no PostgreSQL.
  </p>
  <% if (clients.length) { %>
  <p class="storage-note"><a class="travel-attribution" href="https://www.openstreetmap.org/copyright">© OpenStreetMap contributors</a></p>
  <% } %>
</main>
