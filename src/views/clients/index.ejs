<%- include('../partials/header') %><main id="main-content" class="shell inner-page"><div class="page-title-row"><div><span class="eyebrow">GESTÃO</span><h1>Clientes</h1><p class="muted">Cadastre e organize os dados das empresas atendidas.</p></div><a class="button" href="/clientes/novo">+ Novo cliente</a></div><% if (clients.length) { %><div class="table-wrap"><table><thead><tr><th>Nome</th><th>Empresa</th><th>CNPJ</th><th>E-mail</th><th>Telefone</th><th>Ações</th></tr></thead><tbody><% clients.forEach(client => { %><tr><td><strong><%= client.name %></strong></td><td><%= client.company || '—' %></td><td><%= client.cnpj || '—' %></td><td><%= client.email || '—' %></td><td><%= client.phone || '—' %></td><td class="actions"><a href="/clientes/<%= client.id %>/editar">Editar</a><form action="/clientes/<%= client.id %>/excluir" method="post" onsubmit="return confirm('Excluir este cliente?')"><button class="text-button danger" type="submit">Excluir</button></form></td></tr><% }) %></tbody></table></div><% } else { %><section class="empty-state"><span class="empty-icon">◎</span><h2>Nenhum cliente cadastrado</h2><p>Comece adicionando a primeira empresa. Os registros desta versão são temporários.</p><a class="button" href="/clientes/novo">Cadastrar primeiro cliente →</a></section><% } %><p class="storage-note">ⓘ Nesta etapa, os dados ficam em memória e não são persistidos após reiniciar o servidor.</p></main><%- include('../partials/footer') %>
