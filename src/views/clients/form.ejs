<%- include('../partials/header') %><main id="main-content" class="shell inner-page form-page"><a class="back-link" href="/clientes">← Voltar para clientes</a><span class="eyebrow">GESTÃO DE CLIENTES</span><h1><%= client.id ? 'Editar cliente' : 'Cadastrar cliente' %></h1><p class="muted">Preencha os dados disponíveis. Os campos podem ser complementados posteriormente.</p><% if (errors && errors.length) { %><div class="validation-errors" role="alert"><strong>Revise os campos:</strong><ul><% errors.forEach(error => { %><li><%= error.msg %></li><% }) %></ul></div><% } %><form class="client-form" action="<%= client.id ? '/clientes/' + client.id : '/clientes' %>" method="post"><div class="form-grid"><label>Nome do contato / responsável *<input name="name" value="<%= client.name || '' %>" required maxlength="120" placeholder="Nome completo"></label><label>Empresa<input name="company" value="<%= client.company || '' %>" maxlength="160" placeholder="Nome da empresa"></label><label>CNPJ<input name="cnpj" value="<%= client.cnpj || '' %>" placeholder="00.000.000/0000-00"></label><label>E-mail<input type="email" name="email" value="<%= client.email || '' %>" placeholder="contato@empresa.com"></label><label>Telefone<input type="tel" name="phone" value="<%= client.phone || '' %>" placeholder="(00) 00000-0000"></label></div><div class="form-actions"><a class="button button-ghost" href="/clientes">Cancelar</a><button class="button" type="submit"><%= client.id ? 'Salvar alterações' : 'Cadastrar cliente' %> →</button></div></form></main><%- include('../partials/footer') %>
