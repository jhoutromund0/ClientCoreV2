<main id="main-content" class="shell inner-page form-page">
  <a class="back-link" href="/clientes">
    ← Voltar para clientes
  </a>
  <span class="eyebrow">
    GESTÃO DE CLIENTES
  </span>
  <h1>
    <%= clientData.id ? 'Editar cliente' : 'Cadastrar cliente' %>
  </h1>
  <% if (errors && errors.length) { %>
  <div class="validation-errors" role="alert">
    <strong>
      Revise os campos:
    </strong>
    <ul>
      <% errors.forEach(error => { %>
      <li>
        <%= error.msg %>
      </li>
      <% }) %>
    </ul>
  </div>
  <% } %>
  <form class="client-form" action="<%= clientData.id ? '/clientes/' + clientData.id : '/clientes' %>" method="post">
    <%- include('../partials/csrf-field') %>
    <div class="form-grid">
      <label>
        Nome do contato / responsável *
        <input name="name" value="<%= clientData.name || '' %>" required maxlength="120" placeholder="Nome completo">
      </label>
      <label>
        CNPJ
        <input name="cnpj" value="<%= clientData.cnpj || '' %>" maxlength="18" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="00.000.000/0000-00" aria-describedby="cnpj-status">
      </label>
      <label>
        Empresa
        <input name="company" value="<%= clientData.company || '' %>" maxlength="160" placeholder="Nome da empresa">
      </label>
      <label>
        Tipo de estabelecimento
        <select name="establishmentType">
          <option value="">Não informado</option>
          <option value="matriz"<%= clientData.establishmentType === 'matriz' ? ' selected' : '' %>>Matriz</option>
          <option value="filial"<%= clientData.establishmentType === 'filial' ? ' selected' : '' %>>Filial</option>
        </select>
      </label>
      <label>
        E-mail
        <input type="email" name="email" value="<%= clientData.email || '' %>" maxlength="160" placeholder="contato@empresa.com">
      </label>
      <label>
        Telefone
        <input type="tel" name="phone" value="<%= clientData.phone || '' %>" maxlength="20" placeholder="(00) 00000-0000">
      </label>
      <label class="client-address-field">
        Endereço
        <input name="address" value="<%= clientData.address || '' %>" maxlength="300" placeholder="Rua, número, complemento, bairro, cidade, UF e CEP">
      </label>
    </div>
    <p class="lookup-status" id="cnpj-status" role="status"></p>
    <% if (publicLookup) { %>
    <div class="travel-lookup">
      <input type="hidden" name="expectedRevision" value="<%= transportSettings.revision %>">
      <label class="travel-lookup-confirmation">
        <input type="checkbox" name="publicUse" value="yes" aria-describedby="public-travel-terms">
        <span>Consultar deslocamento ao salvar</span>
      </label>
      <p class="form-hint muted" id="public-travel-terms">Marque apenas para endereços públicos, sem dados pessoais ou confidenciais, e uso não comercial. A partida será de <%= transportSettings.originAddress %>.</p>
      <details class="travel-policy">
        <summary>Regras da consulta pública</summary>
        <p><a href="https://operations.osmfoundation.org/policies/nominatim/">Consulta de endereços</a> · <a href="https://routing.openstreetmap.de/about.html#usage-policy">Cálculo de rotas</a></p>
      </details>
    </div>
    <% } %>
    <div class="form-actions">
      <a class="button button-ghost" href="/clientes">
        Cancelar
      </a>
      <button class="button" type="submit">
        <%= clientData.id ? 'Salvar alterações' : 'Cadastrar cliente' %>
        →
      </button>
    </div>
  </form>
  <% if (clientData.id && travel && !errors.length) { %>
  <section class="panel travel-summary" aria-labelledby="travel-heading">
    <h2 id="travel-heading">Deslocamento</h2>
    <%- include('travel', { trip: travel }) %>
  </section>
  <% } %>
</main>
